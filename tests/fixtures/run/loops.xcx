# XCX 1.2 - while loops, for ranges, break and continue
let (int) counter = 0;
while (counter < 3) do;
    counter = counter + 1;
end;
>! counter;

let (int) sum = 0;
for i in 1 to 5;
    sum = sum + i;
end;
>! sum;

let (int) odd_sum = 0;
for i in 1 to 10;
    if (i % 2 == 0) then;
        continue;
    end;
    odd_sum = odd_sum + i;
end;
>! odd_sum;

let (int) attempts = 0;
while (true) do;
    attempts = attempts + 1;
    if (attempts >= 3) then;
        break;
    end;
end;
>! attempts;

let (int) never = 0;
for i in 5 to 2;
    never = never + i;
end;
>! never;
