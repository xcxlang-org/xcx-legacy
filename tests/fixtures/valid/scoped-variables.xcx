let (int) number = 1;
if (true) then;
    let (int) number = 2;
    >! number;
end;
>! number;
if (true) then;
    let (str) number = "inner";
    >! number;
end;
>! number;
for index in 1 to 2;
    let (int) number = index + 10;
    >! number;
end;
>! number;
let (int) index = 0;
while (index < 2) do;
    let (str) number = "loop";
    index = index + 1;
end;
>! number;
